# BraimSec production image (Hetzner CX22)
#
# Full image shared by the API and the Celery worker.
# Includes the scan engines (semgrep + gitleaks) and ALL python packages
# (api/, scanner/, ai/, reports/, dashboard/).
#
# NOTE: api/main.py and api/tasks.py import scanner/ai/reports via sys.path,
# so copying api/ alone (like the old Dockerfile did) crashes on boot.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- Python deps (API) + semgrep engine ---
# semgrep pinned to the version our custom rules and evals were validated against.
COPY api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt "semgrep==1.178.0"

# --- gitleaks engine (pinned version + sha256, same as scan-runner image) ---
ARG GITLEAKS_VERSION=8.28.0
ARG GITLEAKS_SHA256=a65b5253807a68ac0cafa4414031fd740aeb55f54fb7e55f386acb52e6a840eb
RUN curl -sSL -o /tmp/gitleaks.tar.gz \
        https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz \
    && echo "${GITLEAKS_SHA256}  /tmp/gitleaks.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
    && rm /tmp/gitleaks.tar.gz \
    && gitleaks version

# --- Docker CLI (worker spawns the scan-runner sandbox containers) --------
# Client only (no daemon). Pinned version + sha256 of the official static
# build; only the `docker` CLI binary is extracted.
ARG DOCKER_VERSION=27.3.1
ARG DOCKER_SHA256=9b4f6fe406e50f9085ee474c451e2bb5adb119a03591f467922d3b4e2ddf31d3
RUN curl -sSL -o /tmp/docker.tgz \
        https://download.docker.com/linux/static/stable/x86_64/docker-${DOCKER_VERSION}.tgz \
    && echo "${DOCKER_SHA256}  /tmp/docker.tgz" | sha256sum -c - \
    && tar -xzf /tmp/docker.tgz -C /tmp docker/docker \
    && install -m 0755 /tmp/docker/docker /usr/local/bin/docker \
    && rm -rf /tmp/docker.tgz /tmp/docker \
    && docker --version

# --- Application code (every package the API imports) ---
COPY api/ ./api/
COPY scanner/ ./scanner/
COPY ai/ ./ai/
COPY reports/ ./reports/
COPY dashboard/ ./dashboard/

# --- Non-root runtime user ------------------------------------------------
# The API, worker and beat all run as uid/gid 10001 (never root). Every
# runtime write path is covered: the SQLite DB, scans/ and uploads/ live on
# the HOST_DATA_DIR bind mount (ownership is handed to 10001 once on the
# host — see docker-compose.prod.yml "Server prep"), celerybeat's schedule
# file is in /tmp, and tool caches (git/semgrep in local mode) land in the
# user's home. /app is chowned as belt-and-braces for anything that insists
# on writing next to the code (bytecode is disabled above, so it is not
# expected to be needed).
RUN groupadd --gid 10001 braimsec \
    && useradd --uid 10001 --gid 10001 \
        --home-dir /home/braimsec --create-home braimsec \
    && chown -R braimsec:braimsec /app /home/braimsec
ENV HOME=/home/braimsec

WORKDIR /app/api
EXPOSE 8000
USER 10001

# Overridden per-service in docker-compose (uvicorn api vs celery worker).
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
