# --- BraimSec production env -------------------------------------------
# Copy to .env (same directory) and fill in. NEVER commit real values.
#
# Public address served by Caddy:
#   stage 1 (smoke test):  SITE_ADDRESS=http://<server-ip>
#   stage 2 (production):  SITE_ADDRESS=api.braimsec.world
SITE_ADDRESS=http://127.0.0.1

# --- NowPayments (crypto checkout) — fill when wiring payments -----------
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_PAY_CURRENCY=usdtbsc
PUBLIC_BASE_URL=

# --- LLM providers for AI review (optional) ------------------------------
# The API degrades gracefully without keys (AI-gated findings stay silent).
# GROQ_API_KEY=
# OPENAI_API_KEY=

# --- Sandbox (Docker-isolated scan engines) -------------------------------
# Host directory shared by api+worker at the SAME path (sibling sandbox
# containers mount scan targets by absolute path — no translation).
# Create it on the server once:  sudo mkdir -p /data/braimsec
HOST_DATA_DIR=/data/braimsec

# docker = semgrep+gitleaks run in throwaway scan-runner containers
# (fail-closed: a container error fails the scan, never falls back).
# local  = run the engines in the worker process (dev only).
BRAIMSEC_SCAN_SANDBOX=docker

# Image built once per server from deploy/docker/scan-runner.Dockerfile:
#   docker build -f deploy/docker/scan-runner.Dockerfile \
#       -t braimsec/scan-runner:1.0 .
BRAIMSEC_SCAN_RUNNER_IMAGE=braimsec/scan-runner:1.0

# --- Kill switches / tuning (defaults are production-sane) ---------------
# SINK_AUDIT_OFF=
# SCA_OFFLINE=
