# BraimSec Caddyfile (templated by deploy.sh)
#
# {$SITE_ADDRESS} is rendered from $SITE_ADDRESS in .env:
#   stage 1 (smoke test):  http://<server-ip>      -> plain HTTP, no TLS
#   stage 2 (production):  api.braimsec.world      -> automatic Let's Encrypt TLS

