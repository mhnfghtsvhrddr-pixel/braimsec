# BraimSec Caddyfile
#
# {$SITE_ADDRESS} is read from the caddy container's environment (passed via
# env_file: .env in docker-compose.prod.yml):
#   stage 1 (smoke test):  http://<server-ip>      -> plain HTTP, no TLS
#   stage 2 (production):  api.braimsec.world      -> automatic Let's Encrypt TLS

{$SITE_ADDRESS} {
	reverse_proxy api:8000
}
